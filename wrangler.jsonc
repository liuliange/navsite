{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "navsite",
  "compatibility_date": "2025-08-01",
  "pages_build_output_dir": ".open-next/assets",
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
